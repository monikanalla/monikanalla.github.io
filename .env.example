# Copy to server/.env and fill in before running or deploying.
# Never commit the real file.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/hair5s
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h
CORS_ORIGINS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# First admin account — created by `npm run seed`, then change the password in the panel.
ADMIN_EMAIL=admin@hair5s.local
ADMIN_PASSWORD=ChangeMe123!
